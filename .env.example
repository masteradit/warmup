# Warmup configuration. Copy to .env.local for local dev.
# The app works with zero configuration — every value below has a sensible default.

# --- Cult.fit API client (public web client values; override only if Cult rotates them) ---
# Cult moved its site to next.cult.fit; www.cult.fit serves the same API and is a valid fallback.
CULT_API_BASE=https://next.cult.fit
CULT_API_KEY=9d153009-e961-4718-a343-2a36b0a1d1fd
CULT_APP_VERSION=7
CULT_OS_NAME=browser
CULT_BROWSER_NAME=Web
CULT_TIMEZONE=Asia/Kolkata

# --- OTP login (disabled) ---
# Cult's reCAPTCHA v3 site key. Their key is domain-locked, so tokens minted from
# any non-cult.fit origin are rejected ("captcha is invalid") and phone+OTP login
# cannot work on a third-party deployment. Onboarding is paste-a-cURL only.
# Set NEXT_PUBLIC_ENABLE_OTP_LOGIN=true ONLY if you host on a Cult-approved origin.
NEXT_PUBLIC_CULT_RECAPTCHA_SITE_KEY=6LeggMUhAAAAAGLD3itX--L4Ht7PGzzKl4tNnVkR
NEXT_PUBLIC_ENABLE_OTP_LOGIN=false

# --- Proxy rate limiting (in-memory; per instance) ---
PROXY_RATE_LIMIT_PER_MINUTE=60
